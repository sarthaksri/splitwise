{
  "name": "splitwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Splitwise clone with dish-wise (itemized) bill splitting, groups and debt simplification",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.5.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
