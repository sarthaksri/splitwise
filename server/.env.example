# Copy this file to `server/.env` and fill in the values.

# --- MongoDB Atlas -----------------------------------------------------------
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database Access -> add a database user (username + password)
# 3. Network Access  -> add your IP, or 0.0.0.0/0 for local development
# 4. Connect -> "Drivers" -> copy the SRV connection string and paste it below.
#    Remember to URL-encode any special characters in the password
#    (@ -> %40, # -> %23, / -> %2F ...) and to name the database at the end.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitwise?retryWrites=true&w=majority

# --- Auth --------------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a sign-in lasts. Leave empty (or "never") and sessions never expire —
# you stay signed in until you sign out. Set a duration such as `30d`, `12h` or
# `90m` to time sessions out instead.
#
# Note that nothing here can revoke a token that has already leaked, so an
# unlimited session is only as safe as the devices it was created on. Changing
# JWT_SECRET invalidates every existing session at once, which is the blunt
# instrument if you ever need one.
JWT_EXPIRES_IN=

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Origin(s) allowed to send credentialed requests, comma-separated. In
# development this is the Vite dev server. On Vercel the app and API share an
# origin, so this can be left unset there.
CLIENT_ORIGIN=http://localhost:10000

# --- Deploying to Vercel -----------------------------------------------------
# Set MONGODB_URI and JWT_SECRET in the Vercel project's Environment Variables
# (Settings -> Environment Variables). PORT and CLIENT_ORIGIN are not needed:
# Vercel assigns the port, and the app is served from the same origin as the API.
# Atlas must allow Vercel's IPs — use 0.0.0.0/0 under Network Access, since
# Vercel's serverless functions do not have fixed addresses.
